    {
      "id": "t_kongchang",
      "name": "控场",
      "aliases": [
        "场控"
      ],
      "definition": "由中控或直播负责人配合主播管理直播节奏、数据与氛围的行为。包括上架商品、调整价格、发放优惠券、监测实时转化数据、统计中奖粉丝，以及在突发情况下引导主播调整节奏，确保直播流程顺畅。",
      "scenarios": [
        "直播术语",
        "经营术语"
      ],
      "premise": "",
