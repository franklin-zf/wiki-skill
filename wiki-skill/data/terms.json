    },
    {
      "id": "t_guokuan",
      "name": "过款",
      "aliases": [
        "讲款"
      ],
      "definition": "主播按既定脚本/顺序，向观众依次介绍并讲解直播间陈列商品的过程。强调按节奏逐款展示卖点、引导下单；现代直播常结合实时评论分析动态调整讲解重点或切换款式。",
      "scenarios": [
        "直播术语",
        "经营术语"
      ],
      "premise": "",
