        "updated_at": "2026-05-29",
        "updated_by": "seed"
      }
    },
    {
      "id": "t_biedan",
      "name": "憋单",
      "aliases": [
        "憋库存"
      ],
      "definition": "一种拉长用户停留时长的营销策略。主播将高点击/高转化的福利商品以极具吸引力的低价挂上小黄车，通过话术持续营造福利真实性与“马上开款”的紧张感，却迟迟不放出库存，把想薅羊毛的用户“憋”在直播间，以提升停留时长、拉高在线人数、积蓄流量权重，为后续爆单蓄势。通常单次控制在 5-6 分钟左右便放单。",
      "scenarios": [
        "直播术语",
        "经营术语"
      ],
      "premise": "",
      "meta": {
        "source": "https://www.changbiyuan.com/douyin/zhibo/2022/zhibo_1114/56631.html",
