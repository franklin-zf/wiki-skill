    {
      "id": "t_fudai",
      "name": "福袋",
      "aliases": [
        "自定义福袋",
        "普通福袋"
      ],
      "definition": "直播间的核心互动玩法工具之一。主播可设置参与门槛（如关注主播、加入粉丝团、发送指定评论），系统在满足条件的观众中随机抽取幸运者发放奖品。分为自定义福袋（自定义实物/虚拟奖品，需报白后使用）与普通福袋（仅发放抖币，无需报白）。主要作用是拉动粉丝停留、提升直播间人气与互动数据。",
      "scenarios": [
        "直播术语"
      ],
      "premise": "",
      "meta": {
        "source": "https://www.changbiyuan.com/douyin/zhibo/2022/zhibo_1114/56631.html",
        "source_type": "web",
        "validity": "verified",
